# ---------------------------------------------------------------------------
# PERSIAN PADEL — نمونه‌ی متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/persian_padel?schema=public"

# --- Auth ------------------------------------------------------------------
# کلید امضای نشست — حداقل ۳۲ کاراکتر تصادفی
# تولید: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_TTL_DAYS="30"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Persian Padel"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Tehran"

# --- OTP / SMS -------------------------------------------------------------
# در حالت توسعه کد OTP در کنسول سرور چاپ می‌شود
OTP_PROVIDER="console"          # console | kavenegar | ghasedak
OTP_TTL_SECONDS="120"
OTP_LENGTH="5"
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE="persian-padel-otp"

# --- Payment Gateway (قابل تعویض) -----------------------------------------
PAYMENT_PROVIDER="mock"         # mock | zarinpal | zibal | nextpay
PAYMENT_CALLBACK_URL="http://localhost:3000/api/payments/callback"

ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

ZIBAL_MERCHANT=""

NEXTPAY_API_KEY=""

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_PHONE="09120000000"
