# ---------------------------------------------------------------------------
# PERSIAN PADEL — نمونه‌ی متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
#
# پارامترهای انتهای آدرس را حذف نکنید — زیر بار هم‌زمان تعیین‌کننده‌اند:
#
#   connection_limit  بیشترین اتصال هم‌زمان به پایگاه داده. پیش‌فرض پریزما
#                     «تعداد هسته×۲+۱» است که روی هاست اشتراکی می‌تواند از
#                     سقف مجاز خودِ پستگرس بیشتر شود و اتصال‌ها رد شوند.
#                     روی هاست ایرانی/cPanel عدد ۱۰ نقطه‌ی امنی است.
#   pool_timeout      اگر همه‌ی اتصال‌ها مشغول بودند، چند ثانیه صبر کند و بعد
#                     خطای روشن بدهد. بدون این، درخواست بی‌پایان منتظر می‌ماند
#                     و کاربر فقط «هنگ» می‌بیند.
#   connect_timeout   مهلت برقراری خودِ اتصال.
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/persian_padel?schema=public&connection_limit=10&pool_timeout=15&connect_timeout=10"

# اتصال مستقیم — فقط برای اجرای مهاجرت‌ها استفاده می‌شود.
# روی میزبان‌هایی مثل Neon که هم آدرس pooled و هم آدرس direct می‌دهند،
# اینجا آدرس direct را بگذارید. در غیر این صورت همان DATABASE_URL را کپی کنید.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/persian_padel?schema=public"

# --- Auth ------------------------------------------------------------------
# کلید امضای نشست — حداقل ۳۲ کاراکتر تصادفی
# تولید:  openssl rand -base64 48
# هم نشست‌ها را امضا می‌کند و هم «فلفلِ» هش کدهای یک‌بارمصرف است.
# عوض‌کردنش همه را از حساب بیرون می‌اندازد و کدهای OTPِ در جریان را باطل می‌کند.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_TTL_DAYS="30"

# --- Performance -----------------------------------------------------------
# هش رمز عبور روی استخر نخ‌های libuv اجرا می‌شود. پیش‌فرض این استخر ۴ است؛
# روی سروری که چند نفر هم‌زمان وارد می‌شوند، ۸ فضای تنفس بیشتری می‌دهد.
# بیشتر از تعداد هسته‌ها سودی ندارد.
UV_THREADPOOL_SIZE="8"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Persian Padel"
# نشانی عمومی اپ — برای بازگشت از درگاه پرداخت ضروری است
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Tehran"

# --- SMS / OTP -------------------------------------------------------------
# console  → کد فقط در کنسول سرور چاپ می‌شود (فقط توسعه)
# kavenegar | smsir | ghasedak
OTP_PROVIDER="console"
OTP_TTL_SECONDS="120"
OTP_LENGTH="5"

# کاوه‌نگار — https://kavenegar.com
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE=""

# اس‌ام‌اس ایران — https://sms.ir
SMSIR_API_KEY=""
SMSIR_TEMPLATE_ID=""

# قاصدک — https://ghasedak.me
GHASEDAK_API_KEY=""
GHASEDAK_TEMPLATE=""

# --- Payment Gateway (قابل تعویض) -----------------------------------------
# mock | zarinpal | zibal | nextpay
# هشدار: درگاه mock در محیط تولید مسدود است.
PAYMENT_PROVIDER="mock"

# فقط برای نسخه‌ی آزمایشی: اجازه می‌دهد درگاه mock در محیط تولید هم کار کند،
# یعنی شارژ کیف پول بدون پرداخت واقعی انجام می‌شود. پیش از راه‌اندازی واقعی حذفش کنید.
ALLOW_MOCK_PAYMENT=""

ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

ZIBAL_MERCHANT=""

NEXTPAY_API_KEY=""

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_PHONE="09120000000"

# --- راه‌اندازی یک‌باره پس از استقرار --------------------------------------
# اگر به ترمینال سرور دسترسی ندارید (مثلاً روی Vercel)، این کلید را موقتاً
# تعریف کنید تا مسیر POST /api/setup فعال شود و داده‌ی اولیه را بسازد:
#     curl -X POST https://YOUR-APP/api/setup -H "x-setup-key: YOUR_KEY"
# حداقل ۱۶ کاراکتر. پس از یک بار اجرا، این متغیر را حذف کنید.
SETUP_KEY=""

# --- Docker Compose --------------------------------------------------------
# فقط هنگام استفاده از docker compose لازم است
POSTGRES_USER="padel"
POSTGRES_PASSWORD="یک-رمز-قوی-اینجا-بگذارید"
POSTGRES_DB="persian_padel"
APP_PORT="3000"

# --- Cron (یادآوری رزرو) --------------------------------------------------
# رشته‌ی تصادفی؛ Vercel Cron آن را در هدر Authorization می‌فرستد
# تولید: openssl rand -hex 32
CRON_SECRET=""
